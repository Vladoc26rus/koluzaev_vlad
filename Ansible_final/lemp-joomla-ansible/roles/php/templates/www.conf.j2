[www]
user = {{ php_web_user | default(nginx_user) }}
group = {{ php_web_user | default(nginx_user) }}

listen = {{ php_fpm_socket }}
listen.owner = {{ php_web_user | default(nginx_user) }}
listen.group = {{ php_web_user | default(nginx_user) }}
listen.mode = 0660

pm = dynamic
pm.max_children = 10
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3

clear_env = no
catch_workers_output = yes
